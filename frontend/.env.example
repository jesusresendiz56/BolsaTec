# URL del backend
VITE_API_URL=http://localhost:3000

# Google Maps (mapa en el detalle de la vacante)
# Habilita en Google Cloud: Maps JavaScript API y Geocoding API.
# Restringe la clave por sitio web (bolsa-tec.vercel.app y localhost).
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: Map ID de Google Cloud (para estilos del mapa).
# Si se deja vacío se usa DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
